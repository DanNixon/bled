default: check

fmt:
    cargo fmt

check: clippy
    cargo fmt --check

clippy: (clippy-board "backpack-pico2") (clippy-board "backpack-pico2w") (clippy-board "stamp") (clippy-board "stamp-rm2")

build: build-backpack-pico2 build-backpack-pico2w build-stamp build-stamp-rm2

build-backpack-pico2: (build-board "backpack-pico2")
run-backpack-pico2: (run-board "backpack-pico2")
attach-backpack-pico2: (attach-board "backpack-pico2")

build-backpack-pico2w: (build-board "backpack-pico2w")
run-backpack-pico2w: (run-board "backpack-pico2w")
attach-backpack-pico2w: (attach-board "backpack-pico2w")

build-stamp: (build-board "stamp")
run-stamp: (run-board "stamp")
attach-stamp: (attach-board "stamp")

build-stamp-rm2: (build-board "stamp-rm2")
run-stamp-rm2: (run-board "stamp-rm2")
attach-stamp-rm2: (attach-board "stamp-rm2")

[private]
build-board name:
    cargo build --release --target thumbv8m.main-none-eabihf --no-default-features --features board-{{name}}
    cp ./target/thumbv8m.main-none-eabihf/release/bled ./target/thumbv8m.main-none-eabihf/release/bled-{{name}}
    elf2uf2-rs ./target/thumbv8m.main-none-eabihf/release/bled-{{name}} ./target/thumbv8m.main-none-eabihf/release/bled-{{name}}.uf2
    size ./target/thumbv8m.main-none-eabihf/release/bled-{{name}}

[private]
run-board name: (build-board name)
    probe-rs run --chip RP235x ./target/thumbv8m.main-none-eabihf/release/bled-{{name}}

[private]
attach-board name:
    probe-rs attach --chip RP235x ./target/thumbv8m.main-none-eabihf/release/bled-{{name}}

[private]
clippy-board name:
    cargo clippy --release --target thumbv8m.main-none-eabihf --no-default-features --features board-{{name}} -- -D warnings
