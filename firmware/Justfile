default: check

build: build-pico2w

build-pico2w:
    cargo build --release --target thumbv8m.main-none-eabihf
    elf2uf2-rs ./target/thumbv8m.main-none-eabihf/release/bled ./target/thumbv8m.main-none-eabihf/release/bled.uf2
    size ./target/thumbv8m.main-none-eabihf/release/bled

fmt:
    cargo fmt

clippy:
    cargo clippy --release --target thumbv8m.main-none-eabihf -- -D warnings

check: clippy
    cargo fmt --check

run-pico2w: build-pico2w
    probe-rs run --chip RP235x ./target/thumbv8m.main-none-eabihf/release/bled

attach-pico2w:
    probe-rs attach --chip RP235x ./target/thumbv8m.main-none-eabihf/release/bled
