// ============================================================================
// BLED Badge Case (Two-Part 3D Printable Assembly)
// ============================================================================
// Coordinate System (matches `./fab/bled-badge.stl` exported with `--grid-origin`):
//   Origin (0, 0, 0) : Center of the Badge PCB, on the back copper surface (B.Cu)
//   +X / -X          : Right (+65.25) / Left (-65.25) along the long axis
//   +Y / -Y          : Top (+17.50) / Bottom (-17.50) along the short axis
//   +Z               : Front of badge (PCB thickness = +1.6 mm, LEDs on +Z face)
//   -Z               : Back of badge (BLED Stamp & battery on -Z side)
//
// Generate the board STL before previewing with `show_pcb = true`:
//   just pcbs-models
// ============================================================================

/* [Render / Export Selection] */

// Which part or view to generate: "assembly", "exploded", "print_plate", "front", "back"
part = "assembly"; // [assembly, exploded, print_plate, front, back]

// Show imported `./fab/bled-badge.stl` and component envelopes in assembly views
show_pcb = true;

// Cross-section cut for inspecting internal clearances ("none", "x", "y")
section_cut = "none"; // [none, x, y]

// Separation distance between parts in "exploded" mode (mm)
exploded_distance = 18.0;

/* [Front Diffuser & LED Cavity] */

// Thickness of the thin front LED diffuser layer (mm). Set to 1-2 print layers (e.g. 0.2 - 0.4).
diffuser_thickness = 0.4;

// Depth of the open cavity between the PCB front face and the diffuser (mm).
// XL-1615RGBC-2812B-S LEDs are ~0.8 mm tall; 1.2 mm leaves a 0.4 mm air gap.
led_cavity_depth = 1.2;

// Width (X) of the open LED diffuser window (mm). 50 cols * 2.5 mm pitch = 125.0 mm.
led_window_length = 125.2;

// Height (Y) of the open LED diffuser window (mm). 12 rows * 2.5 mm pitch = 30.0 mm.
led_window_width = 30.2;

// Depth of relief pockets for the two columns of 0402 capacitors at X = +/-63.5 mm (mm)
cap_relief_depth = 0.8;

// Width (X) of each 0402 capacitor relief pocket outside the LED window (mm)
cap_relief_width = 1.8;

/* [PCB Dimensions & Tolerances] */

// Badge PCB nominal length in X (mm)
pcb_length = 130.5;

// Badge PCB nominal width in Y (mm)
pcb_width = 35.0;

// Badge PCB nominal thickness in Z (mm)
pcb_thickness = 1.6;

// Radial XY clearance around the PCB edges inside the case pocket (mm)
pcb_xy_clearance = 0.25;

// Extra Z clearance in the PCB pocket (mm)
pcb_z_clearance = 0.05;

// Width of the clamping ledge supporting the PCB along the top and bottom edges (mm)
pcb_ledge_y = 2.4;

// Width of the clamping ledge supporting the PCB along the left and right ends (mm)
pcb_ledge_x = 1.1;

/* [Case Walls & Back Compartment] */

// Side wall thickness around top/bottom/ends of the case (mm)
wall_thickness = 2.4;

// Back wall thickness (mm)
back_wall_thickness = 2.0;

// Internal depth of the back cavity behind the Badge PCB (Z < 0) for BLED Stamp & LiPo battery (mm).
// BLED Stamp + USB-C / switches requires ~5.0 mm minimum; 8.0 mm fits a LiPo battery comfortably.
back_cavity_depth = 8.0;

// Outer corner fillet radius in the XY plane (mm)
outer_corner_r = 3.5;

// Chamfer size on the outer front & back edges (mm)
outer_edge_chamfer = 0.8;

// Path to the PCB STL generated by `just pcbs-models`
pcb_stl_path = "./fab/bled-badge.stl";

/* [Mounting Screws & Heat-Set Inserts (4x Corners)] */

// Fastener thread clearance hole diameter in the back half (mm) (M2.5 = 2.8, M2 = 2.3, M3 = 3.3)
screw_clearance_d = 2.8;

// Counterbore diameter for screw heads in the back half (mm) (M2.5 = 5.0, M2 = 4.2, M3 = 5.8)
screw_head_d = 5.0;

// Counterbore depth for screw heads in the back half (mm)
screw_head_depth = 2.0;

// Heat-set insert bore diameter in the front half (mm) (M2.5 = 3.5, M2 = 3.0, M3 = 4.0)
insert_hole_d = 3.5;

// Heat-set insert bore depth in the front half (mm)
insert_depth = 4.0;

// Protrusion of the 4 front-half corner bosses into the back half (mm).
// Gives extra Z depth for the heat-set inserts without piercing the thin front diffuser,
// and acts as alignment pins between the two halves.
boss_protrusion = 2.6;

// Diameter of the internal cylindrical boss/socket around each corner screw (mm)
boss_diameter = 7.0;

// Radial clearance around the protruding front bosses in the back half sockets (mm)
boss_fit_clearance = 0.15;

// Distance of screw centers outside the left/right PCB edges in X (mm)
screw_offset_x = 3.75;

// Distance of screw centers inset from the top/bottom PCB edges in Y (mm)
screw_inset_y = 3.5;

/* [USB-C Cutout (Left Wall)] */

// Enable USB-C cutout on the left (-X) wall
enable_usbc_cutout = true;

// Center of USB-C receptacle in Y relative to PCB origin (mm)
usbc_center_y = 0.0;

// Center of USB-C receptacle in Z relative to PCB back face (mm) (1.6mm stamp PCB + 1.6mm half-height)
usbc_center_z = -3.2;

// Width (Y) of the USB-C receptacle through-cutout (mm)
usbc_cutout_w = 9.6;

// Height (Z) of the USB-C receptacle through-cutout (mm)
usbc_cutout_h = 4.0;

// Width (Y) of external USB-C cable overmould recess (mm)
usbc_overmould_w = 13.5;

// Height (Z) of external USB-C cable overmould recess (mm)
usbc_overmould_h = 7.2;

// Remaining wall thickness between the USB-C cable overmould recess and the PCB pocket (mm)
usbc_wall_thickness = 1.2;

/* [Button Access Holes (Back Face)] */

// Enable access holes on the back face for the 6 BLED Stamp tactile switches
enable_button_holes = true;

// Enable debossed text labels next to the button holes on the back face
enable_button_labels = true;

// Diameter of the 6 button access through-holes (mm) (switches are on 3.5 mm X pitch)
button_hole_d = 2.4;

// Chamfer depth around the exterior of each button hole (mm)
button_hole_chamfer = 0.4;

// X coordinates of the 3 button columns relative to PCB origin (mm)
// Top row (+Y): PWR (-59.5), PROG (-56.0), RESET (-52.5)
// Bottom row (-Y): A (-59.5), B (-56.0), C (-52.5)
button_cols_x = [-59.5, -56.0, -52.5];

// Y offset of the two button rows relative to PCB origin (mm)
button_row_y = 9.5;

/* [Resolution] */
$fn = $preview ? 48 : 96;

// ============================================================================
// Derived Dimensions
// ============================================================================

// Internal PCB pocket dimensions (XY)
pocket_length = pcb_length + 2 * pcb_xy_clearance;
pocket_width  = pcb_width  + 2 * pcb_xy_clearance;

// Screw center coordinates
screw_x = pcb_length / 2 + screw_offset_x;
screw_y = pcb_width  / 2 - screw_inset_y;
screw_positions = [
    [-screw_x, -screw_y],
    [-screw_x,  screw_y],
    [ screw_x, -screw_y],
    [ screw_x,  screw_y]
];

// Overall exterior XY dimensions of the case
// Left/right ends extend to enclose the 4 corner screw bosses plus wall margin
end_extension = max(
    pcb_xy_clearance + wall_thickness,
    screw_offset_x + boss_diameter / 2 + 1.0
);
case_length = pcb_length + 2 * end_extension;
case_width  = pocket_width + 2 * wall_thickness;

// Key Z planes (in assembly coordinates)
z_pcb_back    = 0.0;
z_pcb_front   = pcb_thickness + pcb_z_clearance;
z_led_ceiling = z_pcb_front + led_cavity_depth;
z_front_outer = z_led_ceiling + diffuser_thickness;
z_split       = z_pcb_back;
z_back_inner  = -back_cavity_depth;
z_back_outer  = z_back_inner - back_wall_thickness;

front_shell_height = z_front_outer - z_split;
back_shell_height  = z_split - z_back_outer;

// ============================================================================
// Helper Modules
// ============================================================================

// 2D rounded rectangle centered at (0, 0)
module rounded_rect_2d(w, h, r) {
    clamped_r = min(r, min(w, h) / 2 - 0.01);
    if (clamped_r > 0) {
        offset(r = clamped_r)
            square([w - 2 * clamped_r, h - 2 * clamped_r], center = true);
    } else {
        square([w, h], center = true);
    }
}

// 3D extruded rounded box with optional top or bottom outer edge chamfer
module chamfered_outer_shell(w, h, z_min, z_max, r, ch_bottom = 0, ch_top = 0) {
    total_h = z_max - z_min;
    translate([0, 0, z_min])
    hull() {
        if (ch_bottom > 0) {
            linear_extrude(height = 0.01)
                rounded_rect_2d(w - 2 * ch_bottom, h - 2 * ch_bottom, max(0.1, r - ch_bottom));
        }
        translate([0, 0, ch_bottom])
            linear_extrude(height = max(0.01, total_h - ch_bottom - ch_top))
                rounded_rect_2d(w, h, r);
        if (ch_top > 0) {
            translate([0, 0, total_h - 0.01])
                linear_extrude(height = 0.01)
                    rounded_rect_2d(w - 2 * ch_top, h - 2 * ch_top, max(0.1, r - ch_top));
        }
    }
}

// Stadium / rounded-slot prism oriented along the X axis (for USB-C cutouts)
module x_slot_prism(x_start, x_end, width_y, height_z, corner_r) {
    r = min(corner_r, min(width_y, height_z) / 2 - 0.01);
    translate([x_start, 0, 0])
        rotate([0, 90, 0])
            linear_extrude(height = x_end - x_start)
                rounded_rect_2d(height_z, width_y, r);
}

// ============================================================================
// Front Half Module (Diffuser + LED Window + PCB Pocket + Heat-Set Bosses)
// ============================================================================
module case_front() {
    difference() {
        union() {
            // Main front shell body from z_split (0.0) to z_front_outer
            chamfered_outer_shell(
                case_length,
                case_width,
                z_split,
                z_front_outer,
                outer_corner_r,
                ch_bottom = 0,
                ch_top = outer_edge_chamfer
            );

            // 4 protruding corner bosses extending down into the back half (-Z)
            // Provides ample vertical depth for heat-set inserts and aligns the two halves
            for (pos = screw_positions) {
                translate([pos[0], pos[1], z_split - boss_protrusion])
                    cylinder(d = boss_diameter, h = boss_protrusion + 0.05);
            }
        }

        // 1. Open LED cavity directly behind the single-layer front diffuser
        translate([0, 0, z_split - 0.1])
            linear_extrude(height = (z_led_ceiling - z_split) + 0.1)
                square([led_window_length, led_window_width], center = true);

        // 2. Relief pockets for the two columns of 0402 capacitors (C1..C24) on F.Cu
        cap_pocket_x = led_window_length + 2 * cap_relief_width;
        cap_pocket_y = led_window_width - 1.0;
        translate([0, 0, z_split - 0.1])
            linear_extrude(height = (z_pcb_front + cap_relief_depth - z_split) + 0.1)
                square([cap_pocket_x, cap_pocket_y], center = true);

        // 3. Recessed pocket for the Badge PCB (from z_split = 0.0 up to z_pcb_front = 1.65)
        translate([0, 0, z_split - 0.1])
            linear_extrude(height = (z_pcb_front - z_split) + 0.1)
                square([pocket_length, pocket_width], center = true);

        // 4. Blind holes for the 4 corner heat-set inserts (entering from -Z boss face)
        for (pos = screw_positions) {
            translate([pos[0], pos[1], z_split - boss_protrusion - 0.1]) {
                cylinder(d = insert_hole_d, h = insert_depth + 0.1);
                // Small lead-in chamfer for easy heat-set insert alignment
                cylinder(d1 = insert_hole_d + 0.6, d2 = insert_hole_d, h = 0.5);
            }
        }
    }
}

// ============================================================================
// Back Half Module (Rear Cavity + Clamping Rails + USB-C + Button Cutouts)
// ============================================================================
module case_back() {
    // Inner cavity XY span between the left/right screw boss bulkheads
    cavity_x_min = -pcb_length / 2 - pcb_xy_clearance;
    cavity_x_max =  pcb_length / 2 + pcb_xy_clearance;
    cavity_y_span = pocket_width - 2 * pcb_ledge_y;

    difference() {
        // Main back shell body from z_back_outer up to z_split (0.0)
        chamfered_outer_shell(
            case_length,
            case_width,
            z_back_outer,
            z_split,
            outer_corner_r,
            ch_bottom = outer_edge_chamfer,
            ch_top = 0
        );

        // 1. Main internal cavity for BLED Stamp & LiPo battery
        // Leaves `pcb_ledge_y` clamping rails along top/bottom PCB edges (|Y| > 15.35 mm)
        // which press the Badge PCB against the front half without touching the BLED Stamp (|Y| <= 13.68 mm)
        translate([0, 0, z_back_inner])
            linear_extrude(height = back_cavity_depth + 0.1)
                square([pocket_length - 2 * pcb_ledge_x, cavity_y_span], center = true);

        // 2. Left-side clearance extension for the BLED Stamp up to X = -65.0 mm
        // (The BLED Stamp sits at X = [-65.0, +0.75], Y = [-13.68, +13.68])
        stamp_clearance_y = 28.0;
        translate([cavity_x_min, -stamp_clearance_y / 2, z_back_inner])
            cube([pcb_ledge_x + 1.0, stamp_clearance_y, back_cavity_depth + 0.1]);

        // 3. Expanded lower cavity below the PCB clamping ledges (from z_back_inner to z_split - 1.6)
        // Maximises internal width (full pocket_width) for battery & wiring below the clamping rails
        if (back_cavity_depth > 1.6) {
            translate([0, 0, z_back_inner])
                linear_extrude(height = back_cavity_depth - 1.6)
                    square([pocket_length - 2 * pcb_ledge_x, pocket_width], center = true);
        }

        // 4. Sockets in the 4 corners to receive the front-half alignment/insert bosses
        for (pos = screw_positions) {
            translate([pos[0], pos[1], z_split - boss_protrusion - 0.2])
                cylinder(
                    d = boss_diameter + 2 * boss_fit_clearance,
                    h = boss_protrusion + 0.25
                );
        }

        // 5. Four corner mounting screw through-holes + counterbores (entering from z_back_outer)
        for (pos = screw_positions) {
            // Screw shank through-hole
            translate([pos[0], pos[1], z_back_outer - 0.1])
                cylinder(d = screw_clearance_d, h = back_shell_height + 0.2);

            // Screw head counterbore from the flat back face
            translate([pos[0], pos[1], z_back_outer - 0.1])
                cylinder(d = screw_head_d, h = screw_head_depth + 0.1);

            // 45-degree printable conical transition at top of counterbore (prints cleanly with no supports)
            conical_h = (screw_head_d - screw_clearance_d) / 2;
            translate([pos[0], pos[1], z_back_outer + screw_head_depth - 0.01])
                cylinder(d1 = screw_head_d, d2 = screw_clearance_d, h = conical_h + 0.01);
        }

        // 6. USB-C port cutout & cable overmould recess on the left (-X) wall
        if (enable_usbc_cutout) {
            translate([0, usbc_center_y, usbc_center_z]) {
                // Through-opening for the USB-C receptacle tongue/shell
                x_slot_prism(
                    -case_length / 2 - 1.0,
                    cavity_x_min + 2.0,
                    usbc_cutout_w,
                    usbc_cutout_h,
                    usbc_cutout_h / 2
                );

                // Exterior recess for the USB-C cable plug overmould
                x_slot_prism(
                    -case_length / 2 - 1.0,
                    cavity_x_min - usbc_wall_thickness,
                    usbc_overmould_w,
                    usbc_overmould_h,
                    2.0
                );
            }
        }

        // 7. Access holes on the back face for the 6 BLED Stamp buttons (PWR, PROG, RESET, A, B, C)
        if (enable_button_holes) {
            for (bx = button_cols_x) {
                for (by = [-button_row_y, button_row_y]) {
                    translate([bx, by, z_back_outer - 0.1]) {
                        cylinder(d = button_hole_d, h = back_wall_thickness + 0.2);
                        // Exterior entry chamfer
                        cylinder(
                            d1 = button_hole_d + 2 * button_hole_chamfer,
                            d2 = button_hole_d,
                            h  = button_hole_chamfer + 0.1
                        );
                    }
                }
            }
        }

        // 8. Optional debossed button labels on the outer back face
        if (enable_button_holes && enable_button_labels) {
            top_labels    = ["PWR", "PRG", "RST"];
            bottom_labels = ["A",   "B",   "C"];
            label_depth   = 0.4;

            for (i = [0 : 2]) {
                // Top row labels (+Y)
                translate([button_cols_x[i], button_row_y + 3.0, z_back_outer - 0.01])
                    linear_extrude(height = label_depth + 0.01)
                        mirror([1, 0, 0])
                            text(top_labels[i], size = 1.6, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");

                // Bottom row labels (-Y)
                translate([button_cols_x[i], -button_row_y - 3.0, z_back_outer - 0.01])
                    linear_extrude(height = label_depth + 0.01)
                        mirror([1, 0, 0])
                            text(bottom_labels[i], size = 1.8, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");
            }
        }
    }
}

// ============================================================================
// Reference PCB & Component Envelopes (for Assembly Preview)
// ============================================================================
// Uses the `%` background modifier so OpenSCAD displays the board in preview (F5)
// without attempting CGAL boolean operations on KiCad's non-manifold STL during render (F6).
module pcb_reference() {
    %union() {
        color([0.15, 0.55, 0.25, 0.9])
            import(pcb_stl_path, convexity = 10);

        // Ghosted envelopes for components not present in the exported STL:
        // 1. 50x12 LED Matrix envelope on F.Cu (Z = +1.6 to +2.4 mm)
        color([1.0, 0.9, 0.3, 0.35])
            translate([0, 0, pcb_thickness + 0.4])
                cube([124.0, 29.0, 0.8], center = true);

        // 2. USB-C Receptacle (J1) on BLED Stamp (X = [-65.0, -57.5], Y = [-4.5, +4.5], Z = [-4.8, -1.6])
        color([0.75, 0.75, 0.8, 0.7])
            translate([-65.0, -4.47, -4.8])
                cube([7.5, 8.94, 3.2]);

        // 3. 6x Tactile Switches (SW1..SW6) on BLED Stamp (Z = [-3.6, -1.6])
        color([0.3, 0.3, 0.35, 0.7])
            for (bx = button_cols_x)
                for (by = [-button_row_y, button_row_y])
                    translate([bx, by, -2.6])
                        cube([3.0, 4.2, 2.0], center = true);

        // 4. Example LiPo battery envelope in the right-hand battery bay
        color([0.2, 0.4, 0.85, 0.35])
            translate([33.0, 0, -3.5])
                cube([55.0, 28.0, 6.0], center = true);
    }
}

// ============================================================================
// Optional Section Cut Wrapper
// ============================================================================
module apply_section_cut() {
    if (section_cut == "x") {
        difference() {
            children();
            translate([0, -100, -100])
                cube([200, 200, 200]);
        }
    } else if (section_cut == "y") {
        difference() {
            children();
            translate([-100, -200, -100])
                cube([200, 200, 200]);
        }
    } else {
        children();
    }
}

// ============================================================================
// Top-Level Scene / Part Dispatcher
// ============================================================================
apply_section_cut() {
    if (part == "assembly") {
        color([0.92, 0.92, 0.95, 0.85])
            case_front();
        color([0.25, 0.27, 0.30, 0.95])
            case_back();
        if (show_pcb) {
            pcb_reference();
        }
    } else if (part == "exploded") {
        translate([0, 0, exploded_distance])
            color([0.92, 0.92, 0.95, 0.9])
                case_front();
        translate([0, 0, -exploded_distance])
            color([0.25, 0.27, 0.30, 0.95])
                case_back();
        if (show_pcb) {
            pcb_reference();
        }
    } else if (part == "front") {
        // Oriented face-down on the Z=0 print bed for support-free printing
        translate([0, 0, z_front_outer])
            rotate([180, 0, 0])
                case_front();
    } else if (part == "back") {
        // Oriented flat back-down on the Z=0 print bed for support-free printing
        translate([0, 0, -z_back_outer])
            case_back();
    } else if (part == "print_plate") {
        // Both halves arranged side-by-side on the Z=0 build plate
        spacing_y = case_width / 2 + 5.0;

        translate([0, spacing_y, z_front_outer])
            rotate([180, 0, 0])
                case_front();

        translate([0, -spacing_y, -z_back_outer])
            case_back();
    }
}
