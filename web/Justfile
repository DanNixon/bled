default: check

build:
    @tailwindcss -i style/main.css -o style/output.css --minify
    @trunk build --release

test:
    cargo test

fmt:
    cargo fmt

clippy:
    cargo clippy --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -- -D warnings

check: clippy test
    cargo fmt --check

serve:
    trunk serve --port 8080
