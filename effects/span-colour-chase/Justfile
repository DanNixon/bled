default: check

build:
    cargo build --release --target wasm32-unknown-unknown
    wasm-opt -Oz --strip-debug target/wasm32-unknown-unknown/release/span_colour_chase.wasm -o target/wasm32-unknown-unknown/release/span_colour_chase.wasm
    ls -l target/wasm32-unknown-unknown/release/span_colour_chase.wasm

fmt:
    cargo fmt

check:
    cargo fmt --check
    cargo check --target wasm32-unknown-unknown
