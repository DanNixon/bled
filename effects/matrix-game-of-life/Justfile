default: check

build:
    cargo build --release --target wasm32-unknown-unknown
    wasm-opt -Oz --strip-debug target/wasm32-unknown-unknown/release/matrix_game_of_life.wasm -o target/wasm32-unknown-unknown/release/matrix-game-of-life.wasm
    ls -l target/wasm32-unknown-unknown/release/matrix-game-of-life.wasm

fmt:
    cargo fmt

check:
    cargo fmt --check
    cargo check --target wasm32-unknown-unknown
